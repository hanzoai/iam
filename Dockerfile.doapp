# Dockerfile optimized for DigitalOcean App Platform
# Single-stage frontend build
FROM node:18.19.0-alpine AS frontend
WORKDIR /web

# Copy dependency files
COPY ./web/package.json ./web/pnpm-lock.yaml ./web/.npmrc ./
RUN corepack enable && pnpm install --frozen-lockfile

# Copy source and build
COPY ./web .
RUN NODE_OPTIONS="--max-old-space-size=3072" pnpm run build

# Single-stage backend build
FROM golang:1.26-alpine AS backend
WORKDIR /go/src/hanzo-iam

# Install build dependencies
RUN apk add --no-cache git gcc musl-dev

# Copy go modules first
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build Go binary (single architecture)
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /hanzo-iam .

# Final stage
FROM alpine:3.19
LABEL maintainer="Hanzo AI <admin@hanzo.ai>"

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    && addgroup -S hanzo && adduser -S hanzo -G hanzo \
    && mkdir -p /logs /app/tmp && chown -R hanzo:hanzo /logs /app

WORKDIR /app

# Copy binary
COPY --from=backend --chown=hanzo:hanzo /hanzo-iam ./server
COPY --from=backend --chown=hanzo:hanzo /go/src/hanzo-iam/swagger ./swagger
COPY --from=backend --chown=hanzo:hanzo /go/src/hanzo-iam/conf/app.prod.conf ./conf/app.conf
COPY --from=backend --chown=hanzo:hanzo /go/src/hanzo-iam/init_data.json ./init_data.json

# Copy frontend
COPY --from=frontend --chown=hanzo:hanzo /web/build ./web/build

USER hanzo

ENTRYPOINT ["/app/server"]
EXPOSE 8000
