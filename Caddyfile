# Alternative auth domains (redirect to main *.id domains)
auth.hanzo.ai {
	redir https://hanzo.id{uri} permanent
}

auth.zoo.ngo {
	redir https://zoo.id{uri} permanent
}

auth.lux.network {
	redir https://lux.id{uri} permanent
}

auth.pars.ai {
	redir https://pars.id{uri} permanent
}
