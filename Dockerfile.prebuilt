# Simplified Dockerfile for deploying with pre-built frontend
FROM golang:1.24.9 AS builder

WORKDIR /go/src/hanzo-iam

# Copy go modules first
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="-w -s" -o iam-server .

# Final stage
FROM alpine:3.19
LABEL maintainer="Hanzo AI <admin@hanzo.ai>"

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    && mkdir -p /web/build /logs \
    && addgroup -S hanzo && adduser -S hanzo -G hanzo

WORKDIR /app

# Copy binary and configs
COPY --from=builder /go/src/hanzo-iam/iam-server .
COPY --from=builder /go/src/hanzo-iam/swagger ./swagger
COPY --from=builder /go/src/hanzo-iam/conf/app.prod.conf ./conf/app.conf
COPY --from=builder /go/src/hanzo-iam/init_data.json .

# Copy pre-built frontend
COPY web/build ./web/build

RUN chown -R hanzo:hanzo /app /logs
USER hanzo

ENTRYPOINT ["/app/iam-server"]
HEALTHCHECK --interval=30s --timeout=10s --retries=3 CMD curl -f http://localhost:8000/api/health || exit 1
EXPOSE 8000
